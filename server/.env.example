# --- General ---
PORT=3001
LLM_PROVIDER=bedrock            # bedrock | openrouter

# --- AWS Bedrock (auth via AWS SSO, no static access keys) ---
# One-time setup:  aws configure sso
# Each session:    aws sso login --profile <profile>
# The SSO role also needs bedrock:ListFoundationModels and
# bedrock:ListInferenceProfiles for the extension's model picker
# (GET /api/models/bedrock) to work, in addition to
# bedrock:InvokeModelWithResponseStream for actually generating hints.
# Default BEDROCK_MODEL_ID below is a cross-region inference profile ID
# (prefixed "us."/"global."), not a bare model ID — most current-generation
# Claude models on Bedrock require invoking via an inference profile rather
# than a direct on-demand model ID.
AWS_REGION=us-east-1
AWS_PROFILE=<your-sso-profile>
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0

# --- OpenRouter ---
OPENROUTER_API_KEY=
OPENROUTER_MODEL_ID=anthropic/claude-3.5-sonnet

# --- CORS ---
# Comma-separated chrome-extension:// IDs allowed to call this server.
ALLOWED_EXTENSION_IDS=
# Dev-only escape hatch: accepts any chrome-extension:// origin. Do not use in production.
DEV_ALLOW_ANY_EXTENSION_ORIGIN=true
